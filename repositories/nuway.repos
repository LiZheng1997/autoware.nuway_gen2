# Repositories specific to nUWAy (EZ10 Gen2), imported alongside autoware.repos:
#   vcs import src < repositories/autoware.repos
#   vcs import src < repositories/nuway.repos
#
# Note: the nuway.repos in upstream autoware_on_nUWAy uses the custom SSH alias
# git@lee.github.com:. It is spelled as a standard URL here so that anyone cloning this
# repository can import it.
repositories:
  nuway/nuway_canbridge:
    type: git
    url: git@github.com:uwa-rev/canbridge_cpp.git
    version: autoware

# nuway_sensor_kit_launch and nuway_vehicle_launch currently ship with this repository
# (under src/nuway/) rather than being imported. They come from
# uwa-rev/autoware_launch.nuway @ d11bea6 (2026-03-30).
# The whole of autoware_launch.nuway is deliberately not imported, because it also
# contains a forked autoware_launch that collides with the package of the same name in
# 1.9.0; colcon then aborts with "Duplicate package names not supported" and builds
# nothing at all.
# Splitting these two packages into their own repository, and managing them with vcs
# import, would be the cleaner long-term arrangement.
